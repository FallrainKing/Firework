# Copy to .env and fill in real values. NEVER commit .env.

# LLM providers: JSON list of {name, protocol, base_url, api_key, model}.
# protocol: "openai"-compatible or "anthropic"
LLM_PROVIDERS=[{"name":"deepseek","protocol":"openai","base_url":"https://api.deepseek.com/v1","api_key":"sk-xxx","model":"deepseek-chat"},{"name":"huoshan","protocol":"openai","base_url":"https://ark.cn-beijing.volces.com/api/v3","api_key":"sk-xxx","model":"doubao-xxx"}]

# Provider/model tiers (values reference entries in LLM_PROVIDERS)
LLM_FAST=deepseek
LLM_STRONG=deepseek

# Qdrant (host-side default; compose overrides to http://qdrant:6333 inside app)
QDRANT_URL=http://localhost:6333

# SQLite data directory (host-side default; compose overrides to /app/data)
DATA_DIR=./data

# DingTalk group robot webhook (access_token + signing secret)
DINGTALK_TOKEN=
DINGTALK_SECRET=
