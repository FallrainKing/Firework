# Copy to .env and fill in real values. NEVER commit .env.
# Model credentials belong in account-scoped Web model connections, not .env.
# Only the primary administrator legacy mode reads existing host Claude settings.

# Qdrant (host-side default; compose overrides to http://qdrant:6333 inside app)
QDRANT_URL=http://localhost:6333

# SQLite data directory (host-side default; compose overrides to /app/data)
DATA_DIR=./data

# 容器内 data 目录属主对齐（非 1000 用户时覆盖）
# HOST_UID=1000

# Authentication is always enabled in production. Ordinary-account login remains closed.
RESEARCH_AUTH_ADMIN_ONLY=1
RESEARCH_AUTH_COOKIE_SECURE=1
RESEARCH_PUBLIC_ORIGIN=https://paper.matchesai.vip
# Initialize the admin locally; NEVER add a plaintext bootstrap password here.
